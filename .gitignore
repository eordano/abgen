# Rust
/target
/crate/target
/lambda/target
/crate/abgen-wasm/target/
/crate/abgen-node/target/
.cargo-home/

# wasm lab build artifact — crate/abgen-wasm/build.sh regenerates it
/site/wasm/abgen_wasm.wasm

# Generated C/C++ build artifacts (cmake out-of-source builds in the vendored
# third_party crates). Must never be committed: the cmake cache bakes an
# absolute path, so a stale copy breaks the build in a new location (incl. the
# nix sandbox). cmake regenerates these from source.
crate/third_party/draco_decoder/third_party/draco/build/
crate/third_party/**/build/
**/CMakeCache.txt
**/CMakeFiles/
*.a
*.o

# Per-checkout tool config (machine-local unity paths; see
# pipeline/abgencompare/toolconfig.py)
/abgen-compare.json

# Runtime caches / output / env
/lod-parity
/abgen-serve-cache
/data
/runs
/content
/out
*.log
*.env
.env
.env.*

# Nix
/result
/result-*

# Editor / OS noise
__pycache__/
.DS_Store
*.swp
node_modules/

# wasm WebGPU module build artifacts — crate/abgen-wasm/build.sh regenerates
/crate/wasm-gpu/target/
/site/wasm/gpu/

# Unity plugin binaries: built by unity/build.sh or pulled from a release.
# The .meta files beside them are committed — the importer settings are source.
unity/Packages/org.decentraland.abgen/Runtime/Plugins/**/*.dll
unity/Packages/org.decentraland.abgen/Runtime/Plugins/**/*.dylib
unity/Packages/org.decentraland.abgen/Runtime/Plugins/**/*.so

# napi build outputs: the .node is per-platform and comes from the release
# matrix, but index.js/index.d.ts ARE committed — napi-publish never runs
# `napi build`, so nothing would generate the package's entry point.
/crate/abgen-node/*.node
/crate/abgen-node/node_modules/
/crate/abgen-node/npm/**/*.node

# Local release-process rehearsals (release.yml builds these in the runner).
/abgen-v*/
/abgen-v*.tar.gz*
/abgen-native-v*/
/abgen-native-v*.tar.gz*
